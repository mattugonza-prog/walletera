# Copiá este archivo como .env y completalo. El .env no se sube al repositorio.

# Base de datos para `npm start`: la de docker compose o una rama de desarrollo de Neon.
# Sin esta variable la app funciona igual, solo en modo local (sin cuenta).
DATABASE_URL=postgres://walletera:walletera@localhost:5432/walletera

# Base para los tests del servidor. Se BORRA en cada corrida: su nombre tiene que incluir "test".
DATABASE_URL_TEST=postgres://walletera:walletera@localhost:5432/walletera_test

# Mientras exista, la app ofrece "Crear cuenta" a quien conozca este código.
# Usá uno largo y borralo después de crear tu usuario.
CODIGO_REGISTRO=
