{
  "name": "walletera",
  "version": "2.0.0",
  "description": "Billetera personal con cuentas, transferencias, presupuestos y análisis mensual, con datos en la nube o en el navegador.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env servidor/local.js",
    "build": "node scripts/build.js",
    "db:migrar": "node --env-file-if-exists=.env scripts/migrar.js",
    "clave": "node --env-file-if-exists=.env scripts/clave.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "2.1.11",
    "hono": "4.13.19",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "vitest": "5.0.5"
  }
}
